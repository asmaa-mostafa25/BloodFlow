{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "BloodFlow.Api",
    "Audience": "BloodFlow.Client",
    "ExpiryMinutes": 60
  },
  "App": {
    "TimeZone": "Africa/Cairo"
  },
  "BloodFlowAi": {
    "BaseUrl": "http://127.0.0.1:8000",
    "TimeoutSeconds": 30,
    "RetrainTimeoutMinutes": 5
  }
}
